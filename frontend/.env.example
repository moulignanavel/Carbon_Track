# ═══════════════════════════════════════════════════════════════════════════════
# CarbonTrack Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and configure for your environment
# 
# IMPORTANT: Never commit .env.local or .env files with sensitive data
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Configuration ──────────────────────────────────────────────────────────
# API Base URL - must NOT include /api suffix
# The Axios instance will append /api automatically
VITE_API_BASE_URL=http://localhost:8080

# API Timeout in milliseconds
VITE_API_TIMEOUT=15000

# ── Environment ────────────────────────────────────────────────────────────────
# Environment: development | staging | production
VITE_ENV=development

# ── Feature Flags ──────────────────────────────────────────────────────────────
# Enable mock data when backend is unavailable
VITE_USE_MOCK_DATA=false

# Enable API request/response logging
VITE_DEBUG_API=false

# ── Authentication ────────────────────────────────────────────────────────────
# JWT token storage key (localStorage key name)
VITE_TOKEN_KEY=carbontrack_token

# Remember me duration in days
VITE_REMEMBER_ME_DAYS=30

# ── Application ────────────────────────────────────────────────────────────────
# App name (used in UI)
VITE_APP_NAME=CarbonTrack

# App version
VITE_APP_VERSION=0.1.0

# ── Feature Toggles ────────────────────────────────────────────────────────────
# Enable/disable specific features
VITE_ENABLE_LEADERBOARD=true
VITE_ENABLE_ORGANISATION_DASHBOARD=true
VITE_ENABLE_CSR_REPORTS=true
VITE_ENABLE_RECOMMENDATIONS=true

# ── API Retry Configuration ────────────────────────────────────────────────────
# Maximum number of retries for failed requests
VITE_MAX_RETRIES=3

# Retry delay in milliseconds (exponential backoff applied)
VITE_RETRY_DELAY=1000

# ── Pagination ────────────────────────────────────────────────────────────────
# Default items per page
VITE_DEFAULT_PAGE_SIZE=20

# Maximum items per page
VITE_MAX_PAGE_SIZE=100

# ── Cache Configuration ────────────────────────────────────────────────────────
# Cache duration in seconds (0 = no cache)
VITE_CACHE_DURATION=3600

# ── Error Handling ────────────────────────────────────────────────────────────
# Show detailed error messages in development
VITE_VERBOSE_ERRORS=true

# Auto-logout on 401 (unauthorized)
VITE_AUTO_LOGOUT_ON_401=true
